# ==============================================================================
# 6. INVOICES MANAGEMENT
# ==============================================================================

### Create Invoice (Draft)
# @name createInvoice
POST http://localhost:3000/invoices
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "contractId": "{{createContract.response.body.id}}",
  "month": 7,
  "year": 2026
}

### Get All Invoices
# @name getInvoices
GET http://localhost:3000/invoices
Authorization: Bearer {{login.response.body.$.access_token}}

### Get Invoice By ID
# @name getInvoice
GET http://localhost:3000/invoices/{{createInvoice.response.body.id}}
Authorization: Bearer {{login.response.body.$.access_token}}

### Issue Invoice (DRAFT -> ISSUED)
# @name issueInvoice
POST http://localhost:3000/invoices/{{createInvoice.response.body.id}}/issue
Authorization: Bearer {{login.response.body.$.access_token}}

### Pay Invoice (ISSUED -> PAID)
# @name payInvoice
POST http://localhost:3000/invoices/{{createInvoice.response.body.id}}/pay
Authorization: Bearer {{login.response.body.$.access_token}}

# ==============================================================================
# 7. MAINTENANCE REQUESTS
# ==============================================================================
# Business rule:
#   chargeTo OWNER  -> auto-creates an Expense (MAINTENANCE) when actualCost > 0
#   chargeTo TENANT -> tenant pays the technician/landlord directly, outside the
#                      system. No Expense, and NOTHING is added to the invoice.
#   The maintenance request itself is the audit log for the room.
#   tenantId is optional at creation and at resolution.

### 1. Create Maintenance Request (tenantId optional — omit it for a vacant room)
# @name createMaintenanceRequest
POST http://localhost:3000/maintenance-requests
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "roomId": "cmrx290vj0000osb2d23kbfor",
  "tenantId": "cmrx29b1e0001osb2xxh7bo1o",
  "title": "Broken faucet",
  "description": "The faucet is leaking."
}

### 2. Start Maintenance Request (OPEN -> IN_PROGRESS)
# Repeat this call to see the 409 guard: only OPEN requests can be started.
# @name startMaintenanceRequest
PATCH http://localhost:3000/maintenance-requests/{{createMaintenanceRequest.response.body.id}}/start
Authorization: Bearer {{login.response.body.$.access_token}}

### 3. Resolve & Charge The Owner (IN_PROGRESS -> RESOLVED, creates an Expense)
# Repeat this call to see the 409 guard: only IN_PROGRESS requests can be
# resolved. That guard is what prevents a duplicate Expense on a double click.
# @name resolveMaintenanceRequest
PATCH http://localhost:3000/maintenance-requests/{{createMaintenanceRequest.response.body.id}}/resolve
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "chargeTo": "OWNER",
  "estimatedCost": 200000,
  "actualCost": 150000
}

### 3.5. Verify Expense Auto-Created (only for chargeTo OWNER)
# @name verifyMaintenanceExpense
GET http://localhost:3000/expenses
Authorization: Bearer {{login.response.body.$.access_token}}

### 3.6. Resolve & Charge The Tenant (no Expense, no invoice item)
# Works even when the request has no tenantId — tenant settles directly.
# Create + start another request first, then paste its id here.
PATCH http://localhost:3000/maintenance-requests/PASTE_ANOTHER_REQUEST_ID/resolve
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "chargeTo": "TENANT",
  "actualCost": 150000
}

### 4. Create Invoice — rent + electricity + water ONLY
# @name createInvoiceAfterMaintenance
POST http://localhost:3000/invoices
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "contractId": "{{createContract.response.body.id}}",
  "month": 7,
  "year": 2026
}

# Expected Result: exactly 3 items — RENT, ELECTRICITY, WATER.
# There must be NO "OTHER" item for maintenance, whoever paid for it.

