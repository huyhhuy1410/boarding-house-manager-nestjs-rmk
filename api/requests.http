# ==============================================================================
# 9. DASHBOARD
# ==============================================================================

### Get Dashboard Stats
# @name getDashboard
GET http://localhost:3000/dashboard
Authorization: Bearer {{login.response.body.$.access_token}}

# Expected Result: one JSON object, aggregated server-side.
#   totalRooms / occupiedRooms / vacantRooms / occupancyRate  <- room.groupBy
#   totalRevenue (PAID only) / paidInvoices / pendingInvoices <- invoice.groupBy
#   activeContracts                                          <- contract.count
#   dueInvoices        - max 5 ISSUED invoices, nearest dueAt first
#   expiringContracts  - max 5 ACTIVE contracts with endsAt in the future
#
# Cross-check: occupiedRooms must match the OCCUPIED rows in "Get All Rooms",
# and totalRevenue must match the sum of PAID totals in "Get All Invoices".